# Jira Cloud credentials
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token

# Optional: GitHub personal access token (needs repo read access).
# Without this, GitHub PR fetching is skipped and everything else still works.
GITHUB_TOKEN=your-github-personal-access-token

# Optional: Claude Code OAuth token for Claude analysis (reuses your Claude subscription,
# no separate API billing). Generate with `claude setup-token` and paste the
# printed token here. Without this, AI analysis is disabled.
CLAUDE_CODE_OAUTH_TOKEN=your-claude-code-oauth-token
