{
  "name": "sprint-report",
  "version": "1.0.0",
  "description": "CLI tool for measuring sprint ticket turnaround times using Jira and GitHub data",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sprint-report": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "axios": "^1.9.0",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "open": "^10.1.2",
    "ora": "^8.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
